NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Required for the daily keepalive cron (vercel.json -> /api/cron/keepalive)
# to work -- without it, that endpoint just 401s and Supabase's free tier
# will auto-pause the project again after 7 days of no traffic. Any random
# string (e.g. `openssl rand -hex 32`); Vercel automatically sends it as
# `Authorization: Bearer <CRON_SECRET>` on every cron-triggered request once
# this is set in the project's env vars, no other wiring needed.
CRON_SECRET=a-long-random-string

# Optional — matching (both have working defaults, no need to set either).
# Set to "false" to disable semantic (embedding) matching and fall back to
# keyword (BM25) matching only, e.g. if it's too slow/heavy in practice.
# MATCH_USE_EMBEDDINGS=true
# Weight given to semantic similarity vs. BM25 when combining scores, 0..1.
# MATCH_SEMANTIC_WEIGHT=0.5

# Optional — Destiny sync (Upload tab, admin-only "Sync Printed Books from
# Destiny" button). Leave unset and clicking "Sync now" just explains what's
# missing. Use a READ-ONLY SQL login if your Destiny admin can create one.
# DESTINY_DB_HOST=your-destiny-sql-server-host
# DESTINY_DB_PORT=1433
# DESTINY_DB_NAME=your-destiny-database-name
# DESTINY_DB_USER=a-read-only-login
# DESTINY_DB_PASSWORD=its-password
# DESTINY_DB_ENCRYPT=true
# DESTINY_DB_TRUST_CERT=false
# The actual catalog query -- see lib/destiny.ts for the required output
# column names (barcode, call_no, title, author, publisher, year,
# sublocation, copies). Only needed if the built-in placeholder doesn't
# match your Destiny instance's real schema (it almost certainly won't
# without editing). "sublocation" should be Destiny's raw site/section
# name (e.g. "CCRD - Araceli", "Main - Circulation") -- lib/destiny.ts
# maps that down to this app's campus names, it doesn't need pre-mapping
# in the SQL itself.
# DESTINY_CATALOG_QUERY=select ...

# Optional — Hostinger MySQL overflow storage (Upload tab, admin-only
# "Migrate Unmatched eBooks to Hostinger" tool; also required for the
# "Perlego Catalog" tab to work). Used to move eBook titles that have
# never been assigned to any course out of Supabase once its free-tier
# storage cap gets tight, instead of deleting them. Needs Hostinger's
# hPanel "Remote MySQL" access opened so Vercel can actually reach it, and
# the perlego_titles table created first -- see the CREATE TABLE statement
# in lib/hostinger-mysql.ts.
# HOSTINGER_DB_HOST=your-hostinger-mysql-host
# HOSTINGER_DB_PORT=3306
# HOSTINGER_DB_NAME=your-database-name
# HOSTINGER_DB_USER=your-database-user
# HOSTINGER_DB_PASSWORD=its-password
# HOSTINGER_DB_SSL=false
