# Copy this file to destiny-push.env (same folder) and fill it in.
# destiny-push.env is gitignored -- it holds a database password and a
# secret token, never commit it.

# Same connection info as the app's own DESTINY_DB_* vars (see
# .env.example) -- just used locally here instead of from Vercel.
DESTINY_DB_HOST=your-destiny-sql-server-host
DESTINY_DB_PORT=1433
DESTINY_DB_NAME=your-destiny-database-name
DESTINY_DB_USER=a-read-only-login
DESTINY_DB_PASSWORD=its-password
DESTINY_DB_ENCRYPT=true
DESTINY_DB_TRUST_CERT=false
# DESTINY_CATALOG_QUERY=select ...

# This app's URL and the same DESTINY_INGEST_SECRET value set in Vercel's
# project env vars.
PUSH_APP_URL=https://psulibbiblio.vercel.app
DESTINY_INGEST_SECRET=another-long-random-string
